APP_NAME="POS Cloud"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos_cloud
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# Use log until Google App Password / mail transport is configured.
MAIL_MAILER=log
# Gmail SMTP setup (set your own values in .env, never commit secrets):
# MAIL_MAILER=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_SCHEME=smtp
# MAIL_USERNAME=youraddress@gmail.com
# MAIL_PASSWORD=YOUR_GOOGLE_APP_PASSWORD
# MAIL_FROM_ADDRESS=youraddress@gmail.com
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="POS Cloud"

SAAS_TRIAL_DAYS=14
SAAS_DEFAULT_CURRENCY=LKR
SAAS_DEFAULT_TIMEZONE=Asia/Colombo

VITE_APP_NAME="POS Cloud"
