APP_NAME="POS Cloud"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pos_cloud
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=database
QUEUE_CONNECTION=database

# cPanel domain mailbox; fill MAIL_PASSWORD only in your private .env.
# Code-based admin 2FA requires a working SMTP transport.
MAIL_MAILER=smtp
MAIL_HOST=web7softwares.com
MAIL_PORT=465
MAIL_SCHEME=smtps
MAIL_USERNAME=info@web7softwares.com
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=info@web7softwares.com
MAIL_FROM_NAME="POS Cloud"

# Platform security (uncomment only to override environment default).
PLATFORM_REQUIRE_2FA=true
# Enforces email OTP for all platform administrators when enabled.
SECURITY_PASSWORD_MIN_LENGTH=12
SECURITY_PASSWORD_EXPIRY_DAYS=0

SAAS_TRIAL_DAYS=14
SAAS_DEFAULT_CURRENCY=LKR
SAAS_DEFAULT_TIMEZONE=Asia/Colombo

VITE_APP_NAME="POS Cloud"

# Phase 5 notifications are disabled for external email in Platform Settings by default.
# Do not commit MAIL_PASSWORD or production SMTP secrets.
# Use: php artisan queue:work --queue=communications,default --tries=3
